<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- PACTware e os demais Frames FDT 1.x são processos de 32 bits: o DTM é registrado com o regasm de 32 bits. -->
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Version>2.0.0</Version>
    <Company>JosueLab</Company>
    <Product>Lasec HART Communication DTM</Product>
    <Description>Comm DTM FDT 1.2 (mestre HART): modem serial/USB/Bluetooth, HART-IP (WirelessHART) e ponte UDP.</Description>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HartEngine\HartEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Interop oficial FDT 1.2 (FDT-JIG, assinado). Frames .NET usam o mesmo assembly: as interfaces FDT têm a
         mesma identidade dos dois lados. -->
    <Reference Include="Jigfdt.fdt100">
      <HintPath>..\..\dlls\JIGFDT.FDT100.DLL</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
