<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>

    <!-- WINFORMS -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Strong Name -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>LasecHartCommDTM.snk</AssemblyOriginatorKeyFile>
    <!-- Garantir que o DTM é compilado como x86 (match com PACTware 32-bit) -->
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Forçar WinForms no build Core -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml" />
    <Reference Include="System" />
    <!-- Jigfdt interop – embed interfaces for Type Equivalence with PACTware -->
    <Reference Include="Jigfdt.fdt100">
      <HintPath>C:\Program Files (x86)\PACTware Consortium\PACTware 5.0\Jigfdt.fdt100.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Merge HartEngine source directly to avoid separate DLL dependency -->
  <ItemGroup>
    <Compile Include="..\HartEngine\IChannel.cs" />
    <Compile Include="..\HartEngine\ChannelManager.cs" />
    <Compile Include="..\HartEngine\UdpChannel.cs" />
    <Compile Include="..\HartEngine\TcpChannel.cs" />
    <Compile Include="..\HartEngine\SerialChannel.cs" />
    <!-- Exclude FDT interfaces replaced by embedded Jigfdt types (keep IDtmView) -->
    <Compile Remove="FdtInterfaces\IDtmInformation.cs" />
    <Compile Remove="FdtInterfaces\IDtm.cs" />
    <Compile Remove="FdtInterfaces\ICommChannel.cs" />
    <Compile Remove="FdtInterfaces\IFdtCommunicationEvents.cs" />
    <Compile Remove="FdtInterfaces\IFdtContainer.cs" />
  </ItemGroup>

</Project>