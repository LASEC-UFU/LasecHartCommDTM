<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>

    <!-- WINFORMS -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Strong Name -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>LasecHartCommDTM.snk</AssemblyOriginatorKeyFile>
    <!-- Garantir que o DTM é compilado como x86 (match com PACTware 32-bit) -->
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Forçar WinForms no build Core -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml" />
    <Reference Include="System" />
  </ItemGroup>

  <!-- Merge HartEngine source directly to avoid separate DLL dependency -->
  <ItemGroup>
    <Compile Include="..\HartEngine\IChannel.cs" />
    <Compile Include="..\HartEngine\ChannelManager.cs" />
    <Compile Include="..\HartEngine\SerialChannel.cs" />
    <Compile Include="..\HartEngine\UdpChannel.cs" />
  </ItemGroup>

</Project>