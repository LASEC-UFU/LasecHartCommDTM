<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="Lasec HART Communication DTM"
      Language="1033"
      Version="1.0.0.0"
      Manufacturer="JosueLab"
      UpgradeCode="1F6D3983-1B43-4F41-9204-4FAE6E4F0010"
      InstallerVersion="500"
      Compressed="yes"
      Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_Minimal" />

    <!-- ================================================================
         Diretórios
         ================================================================ -->
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="PACTWARE" Name="PACTware 5.0">
        <Directory Id="DTM700" Name="DTM700">
          <Directory Id="JosueLab" Name="JosueLab">
            <Directory Id="LasecHartCommDTM" Name="LasecHartCommDTM">
              <Directory Id="DTM" Name="Dtm">

                <Component Id="DTMFilesComponent"
                           Guid="C4A111F0-A78C-4320-BBB7-34A93B910010">

                  <File Id="LasecHartCommDTMFile"
                        Source="$(var.OutputDir)\LasecHartCommDTM.dll"
                        KeyPath="yes"/>

                  <!-- ============================================================
                       COM registration manual — mais confiável que regasm
                       Para pacote x86, HKLM\SOFTWARE\Classes é redirecionado
                       para WOW6432Node pelo WOW64
                       ============================================================ -->

                  <!-- ProgID -->
                  <RegistryValue Root="HKLM"
                                 Key="SOFTWARE\Classes\LasecHartCommDTM.CommDtm"
                                 Type="string" Value="LasecHartCommDTM.CommDtm"/>
                  <RegistryValue Root="HKLM"
                                 Key="SOFTWARE\Classes\LasecHartCommDTM.CommDtm\CLSID"
                                 Type="string" Value="{B4B6B3E7-639D-460B-B9A0-6C7F7EB20010}"/>

                  <!-- CLSID base -->
                  <RegistryValue Root="HKLM"
                                 Key="SOFTWARE\Classes\CLSID\{B4B6B3E7-639D-460B-B9A0-6C7F7EB20010}"
                                 Type="string" Value="LasecHartCommDTM.CommDtm"/>

                  <!-- InprocServer32 — CLR loader (mscoree.dll) -->
                  <RegistryValue Root="HKLM"
                                 Key="SOFTWARE\Classes\CLSID\{B4B6B3E7-639D-460B-B9A0-6C7F7EB20010}\InprocServer32"
                                 Type="string" Value="mscoree.dll"/>
                  <RegistryValue Root="HKLM"
                                 Key="SOFTWARE\Classes\CLSID\{B4B6B3E7-639D-460B-B9A0-6C7F7EB20010}\InprocServer32"
                                 Name="ThreadingModel" Type="string" Value="Both"/>
                  <RegistryValue Root="HKLM"
                                 Key="SOFTWARE\Classes\CLSID\{B4B6B3E7-639D-460B-B9A0-6C7F7EB20010}\InprocServer32"
                                 Name="Class" Type="string" Value="LasecHartCommDTM.CommDtm"/>
                  <RegistryValue Root="HKLM"
                                 Key="SOFTWARE\Classes\CLSID\{B4B6B3E7-639D-460B-B9A0-6C7F7EB20010}\InprocServer32"
                                 Name="Assembly" Type="string"
                                 Value="LasecHartCommDTM, Version=1.0.0.0, Culture=neutral, PublicKeyToken=45a43f6ca7aaed45"/>
                  <RegistryValue Root="HKLM"
                                 Key="SOFTWARE\Classes\CLSID\{B4B6B3E7-639D-460B-B9A0-6C7F7EB20010}\InprocServer32"
                                 Name="RuntimeVersion" Type="string" Value="v4.0.30319"/>
                  <!-- CodeBase: caminho do DLL em formato file:/// -->
                  <RegistryValue Root="HKLM"
                                 Key="SOFTWARE\Classes\CLSID\{B4B6B3E7-639D-460B-B9A0-6C7F7EB20010}\InprocServer32"
                                 Name="CodeBase" Type="string"
                                 Value="file:///[DTM]LasecHartCommDTM.dll"/>

                  <!-- ============================================================
                       FDT DTM Component Categories — obrigatório para PACTware
                       {036D1490} FDT DTM (discovery)
                       {036D1493} FDT 1.2 DTM
                       {036D1494} FDT CommDTM
                       {036D1495} FDT 1.x compatible
                       {036D1498} HART Bus — PACTware filtra por esta categoria!
                       ============================================================ -->
                  <RegistryValue Root="HKLM"
                                 Key="SOFTWARE\Classes\Component Categories\{036D1490-387B-11D4-86E1-00E0987270B9}"
                                 Type="string" Value="FDT DTM"/>
                  <RegistryValue Root="HKLM"
                                 Key="SOFTWARE\Classes\Component Categories\{036D1498-387B-11D4-86E1-00E0987270B9}"
                                 Type="string" Value="HART"/>

                  <RegistryValue Root="HKLM"
                                 Key="SOFTWARE\Classes\CLSID\{B4B6B3E7-639D-460B-B9A0-6C7F7EB20010}\Implemented Categories\{036D1490-387B-11D4-86E1-00E0987270B9}"
                                 Type="string" Value=""/>
                  <RegistryValue Root="HKLM"
                                 Key="SOFTWARE\Classes\CLSID\{B4B6B3E7-639D-460B-B9A0-6C7F7EB20010}\Implemented Categories\{036D1493-387B-11D4-86E1-00E0987270B9}"
                                 Type="string" Value=""/>
                  <RegistryValue Root="HKLM"
                                 Key="SOFTWARE\Classes\CLSID\{B4B6B3E7-639D-460B-B9A0-6C7F7EB20010}\Implemented Categories\{036D1494-387B-11D4-86E1-00E0987270B9}"
                                 Type="string" Value=""/>
                  <RegistryValue Root="HKLM"
                                 Key="SOFTWARE\Classes\CLSID\{B4B6B3E7-639D-460B-B9A0-6C7F7EB20010}\Implemented Categories\{036D1495-387B-11D4-86E1-00E0987270B9}"
                                 Type="string" Value=""/>
                  <RegistryValue Root="HKLM"
                                 Key="SOFTWARE\Classes\CLSID\{B4B6B3E7-639D-460B-B9A0-6C7F7EB20010}\Implemented Categories\{036D1498-387B-11D4-86E1-00E0987270B9}"
                                 Type="string" Value=""/>

                  <!-- .NET Category — PACTware usa para rotear para CLR surrogate -->
                  <RegistryValue Root="HKLM"
                                 Key="SOFTWARE\Classes\CLSID\{B4B6B3E7-639D-460B-B9A0-6C7F7EB20010}\Implemented Categories\{62C8FE65-4EBB-45e7-B440-6E39B2CDBF29}"
                                 Type="string" Value=""/>

                  <!-- Marcador de instalação -->
                  <RegistryValue Root="HKLM"
                                 Key="Software\JosueLab\LasecHartCommDTM"
                                 Name="Installed" Type="integer" Value="1"/>

                </Component>
              </Directory>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Agrupamento -->
    <ComponentGroup Id="DTMFiles">
      <ComponentRef Id="DTMFilesComponent"/>
    </ComponentGroup>

    <!-- FEATURE -->
    <Feature Id="MainFeature"
             Title="Lasec HART Communication DTM"
             Level="1">
      <ComponentGroupRef Id="DTMFiles"/>
    </Feature>

  </Package>

</Wix>
